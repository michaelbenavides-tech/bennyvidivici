# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aisgp
POSTGRES_USER=aisgp
POSTGRES_PASSWORD=changeme_in_production

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_in_production

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_in_production
MINIO_BUCKET_ARTIFACTS=ai-sgp-artifacts
MINIO_BUCKET_EVIDENCE=ai-sgp-evidence
MINIO_USE_SSL=false

# Keycloak
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=ai-sgp
KEYCLOAK_CLIENT_ID=ai-sgp-backend
KEYCLOAK_CLIENT_SECRET=changeme_in_production
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme_in_production

# Application
SECRET_KEY=changeme_in_production_use_openssl_rand_hex_32
CORS_ORIGINS=["http://localhost","http://localhost:5173"]
LOG_LEVEL=INFO
ENVIRONMENT=development
AUTH_DISABLED=true

# Email
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=noreply@ai-sgp.local
SMTP_TLS=false

# Frontend
VITE_API_URL=http://localhost/api/v1
VITE_KEYCLOAK_URL=http://localhost/auth
VITE_KEYCLOAK_REALM=ai-sgp
VITE_KEYCLOAK_CLIENT_ID=ai-sgp-frontend
